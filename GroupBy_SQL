
/*
-- Q1. Find the total number of orders placed by each customer.
-- Display:
-- CustomerID
-- TotalOrders*/

select 
customerid,

count(orderid) as total_orders

from sales.orders
group by customerid

/*-- Q2. Find the total sales generated by each customer.
-- Display:
-- CustomerID
-- TotalSales */
select customerid,
sum(sales) as tot_sales
from sales.orders
group by customerid

/* -- Q3. Find the total quantity sold for each product.
-- Display:
-- ProductID
-- TotalQuantity*/

select * from sales.orders

select 
productid,
sum(quantity)over(partition by productid) tot_quantity
from sales.orders


select 
productid,
sum(quantity)as tot_quantity
from sales.orders
group by productid


/*-- Q4. Find the average sales amount for each product.
-- Display:
-- ProductID
-- AverageSales*/


select productid,
avg(sales)over(partition by productid)as avg_sales
from sales.orders

/* -- Q5. Find the highest sales amount from a single order for each customer.
-- Display:
-- CustomerID
-- MaxOrderSales*/

select * from sales.orders

select 
customerid,
max(sales) max_order_sales
from sales.orders
group by customerid

/* -- Q6. For each department, find:
-- 1. Minimum salary
-- 2. Maximum salary
-- 3. Average salary
--
-- Display:
-- Department
-- MinSalary
-- MaxSalary
-- AvgSalary */

select * from sales.Customers

select 
department,
min(salary) as min_salary,
max(salary) as max_salary,
avg(salary) as avg_salary
from sales.employees
group by department

/*-- Q7. Find the number of employees working in each department.
-- Display:
-- Department
-- EmployeeCount*/

select 
department,
count(*)over (partition by department)as tot_emp_count
from sales.employees

/*-- Q8. Calculate the total salary expense for each department.
-- Display:
-- Department
-- TotalSalary*/

select department,
sum(salary) as total_salary
from sales.employees
group by department
having sum(salary)>200000

/*-- Q9. Find how much total sales each salesperson generated.
-- Display:
-- SalesPersonID
-- TotalSales*/

select 
salespersonId,
sum(sales) over(partition by salespersonid) tot_sales_each
from sales.orders

/* -- Q10. Find the number of orders for each OrderStatus.
-- Display:
-- OrderStatus
-- TotalOrders*/

select
orderstatus,
sum(orderid) as tot_orders
from sales.orders
where orderstatus ='delivered'
group by orderstatus
